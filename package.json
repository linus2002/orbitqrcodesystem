{
  "name": "qr-shield",
  "version": "1.0.0",
  "private": true,
  "description": "QR Shield — anti-counterfeit healthcare product verification system (serialization, public verification portal, security dashboard).",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/server.js",
  "scripts": {
    "prestart": "node scripts/migrate.js",
    "start": "node src/server.js",
    "build": "vite build",
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch src/server.js",
    "dev:client": "vite",
    "preview": "npm run build && node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:pg-schema": "node scripts/gen-pg-schema.js && node scripts/check-pg-schema.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "setup": "node scripts/setup.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:e2e": "node tests/e2e.js",
    "test:all": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsqr": "^1.4.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "pg-mem": "^3.0.14",
    "vite": "^8.3.0"
  }
}
